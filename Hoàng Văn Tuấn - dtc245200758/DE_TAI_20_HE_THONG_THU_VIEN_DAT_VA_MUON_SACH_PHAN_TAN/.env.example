# Sao chép thành .env.local (đã được .gitignore) rồi điền giá trị thật.
# Chạy trực tiếp trên Windows: PostgreSQL localhost:5433, RabbitMQ localhost:5672.
DB_URL=jdbc:postgresql://localhost:5433/library_db
DB_USER=library_user
DB_PASSWORD=change_me
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=library_admin
RABBIT_PASSWORD=change_me
