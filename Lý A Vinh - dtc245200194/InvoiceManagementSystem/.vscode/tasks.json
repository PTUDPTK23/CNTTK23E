{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend API (localhost:5000)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/backend/InvoiceManagementSystem.Api/InvoiceManagementSystem.Api.csproj",
        "--launch-profile",
        "InvoiceManagementSystem.Api"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend (localhost:5500)",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "http.server",
        "5500",
        "--bind",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
