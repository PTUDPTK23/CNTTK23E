@inherits LayoutComponentBase

<div class="app-container">
    <!-- Sidebar -->
    <aside class="sidebar @(isCollapsed ? "collapsed" : "")">
        <div class="sidebar-header">
            <a href="" class="brand-logo">
                <div class="brand-icon">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                </div>
                @if (!isCollapsed)
                {
                    <span style="letter-spacing: -0.03em;">EventFlow</span>
                }
            </a>
            <button class="btn-ef-secondary" style="padding: 0.35rem; border: none;" @onclick="ToggleSidebar" title="Thu gọn/Mở rộng menu">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                </svg>
            </button>
        </div>

        <NavMenu />
    </aside>

    <!-- Main Wrapper -->
    <div class="main-wrapper">
        <!-- Topbar -->
        <header class="topbar">
            <div class="topbar-left">
                <span style="font-weight: 600; font-size: 0.95rem; color: var(--text-primary);">
                    Hệ thống Quản lý Sự kiện & Check-in Phân tán (Đề tài 18)
                </span>
            </div>

            <div class="topbar-right">
                <div class="status-indicator">
                    <span class="dot-live"></span>
                    <span style="font-size: 0.8rem; color: var(--text-secondary);">RabbitMQ Topic Exchange</span>
                </div>
                <div class="badge-modern badge-primary">
                    .NET 10 Minimal API
                </div>
            </div>
        </header>

        <!-- Main Content View -->
        <main class="main-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool isCollapsed = false;

    private void ToggleSidebar()
    {
        isCollapsed = !isCollapsed;
    }
}
