@page "/registration-success/{code}"
@rendermode InteractiveServer
@inject EventApiClient EventApi
@inject IJSRuntime JSRuntime

<PageTitle>Xác nhận Đăng ký Thành công - EventFlow</PageTitle>

@if (isLoading)
{
    <div style="text-align: center; padding: 4rem 1rem;">
        <div style="display: inline-block; width: 32px; height: 32px; border: 3px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
        <p class="mt-2" style="font-size: 0.9rem;">Đang tải thông tin vé...</p>
    </div>
}
else if (ticket == null)
{
    <div class="card-modern" style="text-align: center; padding: 3rem 1rem; max-width: 600px; margin: 0 auto;">
        <h3 style="color: var(--danger); margin-bottom: 0.5rem;">Không tìm thấy thông tin vé</h3>
        <p>Mã đăng ký "@(Code)" không tồn tại trong hệ thống.</p>
        <a href="events" class="btn-ef-primary mt-2">Quay lại trang chủ</a>
    </div>
}
else
{
    <div style="max-width: 680px; margin: 0 auto;">
        <!-- Top alert -->
        <div class="card-modern mb-4" style="text-align: center; border-top: 4px solid var(--success); padding: 2rem;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background-color: var(--success-light); color: var(--success); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
                <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.4rem;">
                Đăng ký Tham dự Thành công!
            </h2>
            <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 0;">
                Thông tin đăng ký của bạn đã được ghi nhận vào hệ thống và phát thông báo qua RabbitMQ. Vui lòng lưu lại mã vé điện tử dưới đây để thực hiện check-in tại sự kiện.
            </p>
        </div>

        <!-- Electronic Ticket Boarding Pass -->
        <div class="card-modern mb-4" style="border: 2px dashed var(--primary-border); background-color: var(--surface); padding: 1.75rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 1rem; margin-bottom: 1.25rem;">
                <div>
                    <span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--primary); letter-spacing: 0.05em;">VÉ ĐIỆN TỬ THAM DỰ</span>
                    <h3 style="font-size: 1.25rem; font-weight: 700; margin: 0.2rem 0 0 0;">@ticket.EventName</h3>
                </div>
                <span class="badge-modern @GetStatusBadgeClass(ticket.Status)">
                    @GetStatusName(ticket.Status)
                </span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 200px; gap: 1.5rem; align-items: center;">
                <div>
                    <!-- Registration Code Highlight -->
                    <div style="background-color: var(--primary-light); border: 1px solid var(--primary-border); border-radius: var(--radius-sm); padding: 0.85rem; margin-bottom: 1.25rem;">
                        <div style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600;">Mã Đăng ký (Registration Code)</div>
                        <div style="font-size: 1.6rem; font-weight: 800; color: var(--primary); font-family: monospace; letter-spacing: 0.05em;">
                            @ticket.RegistrationCode
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.875rem;">
                        <div>
                            <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">Họ và tên</span>
                            <strong style="color: var(--text-primary);">@ticket.ParticipantName</strong>
                        </div>
                        <div>
                            <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">Email</span>
                            <span style="color: var(--text-primary);">@ticket.ParticipantEmail</span>
                        </div>
                        <div>
                            <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">Thời gian sự kiện</span>
                            <span style="color: var(--text-primary);">@ticket.EventStartTime.ToString("HH:mm - dd/MM/yyyy")</span>
                        </div>
                        <div>
                            <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">Thời điểm đăng ký</span>
                            <span style="color: var(--text-primary);">@ticket.RegisteredAt.ToString("HH:mm dd/MM/yyyy")</span>
                        </div>
                        <div style="grid-column: span 2;">
                            <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">Địa điểm</span>
                            <span style="color: var(--text-primary);">@ticket.EventLocation</span>
                        </div>
                    </div>
                </div>

                <!-- QR Code Box -->
                <div style="text-align: center; border-left: 1px dashed var(--border); padding-left: 1.25rem;">
                    <div class="qr-code-box">
                        @((MarkupString)QrCodeHelper.GenerateSvgQr(ticket.RegistrationCode, 4))
                    </div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.4rem;">
                        Quét mã tại quầy Check-in
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div style="display: flex; gap: 1rem; justify-content: center;">
            <button class="btn-ef-secondary" @onclick="PrintTicket">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                <span>In vé / Lưu PDF</span>
            </button>
            <a href="my-registrations" class="btn-ef-secondary">
                Tra cứu vé khác
            </a>
            <a href="events" class="btn-ef-primary">
                Về danh sách sự kiện
            </a>
        </div>
    </div>
}

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    private RegistrationDetailDto? ticket;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTicketAsync();
    }

    private async Task LoadTicketAsync()
    {
        isLoading = true;
        try
        {
            ticket = await EventApi.GetRegistrationByCodeAsync(Code);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PrintTicket()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private static string GetStatusBadgeClass(RegistrationStatus status) => status switch
    {
        RegistrationStatus.Confirmed => "badge-primary",
        RegistrationStatus.CheckedIn => "badge-success",
        RegistrationStatus.Cancelled => "badge-danger",
        _ => "badge-secondary"
    };

    private static string GetStatusName(RegistrationStatus status) => status switch
    {
        RegistrationStatus.Confirmed => "Đã xác nhận",
        RegistrationStatus.CheckedIn => "Đã check-in",
        RegistrationStatus.Cancelled => "Đã hủy",
        _ => "Không rõ"
    };
}
