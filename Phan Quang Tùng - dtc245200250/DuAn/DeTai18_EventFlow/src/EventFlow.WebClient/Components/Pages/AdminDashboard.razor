@page "/admin/dashboard"
@rendermode InteractiveServer
@inject DashboardSignalRClient SignalRClient
@inject EventApiClient EventApi
@implements IAsyncDisposable

<PageTitle>Realtime Dashboard - EventFlow</PageTitle>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.2rem;">Realtime Operational Dashboard</h1>
        <p style="font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 0;">
            Giám sát trực tiếp luồng đăng ký và check-in sự kiện qua SignalR và RabbitMQ Topic Exchange.
        </p>
    </div>

    <div style="display: flex; align-items: center; gap: 1rem;">
        <div class="card-modern" style="padding: 0.4rem 0.85rem; display: flex; align-items: center; gap: 0.6rem;">
            @if (isConnected)
            {
                <span class="dot-live"></span>
                <span style="font-size: 0.825rem; font-weight: 600; color: var(--success);">SignalR Trực tiếp</span>
            }
            else
            {
                <span class="dot-offline"></span>
                <span style="font-size: 0.825rem; font-weight: 500; color: var(--text-muted);">Đang kết nối lại...</span>
            }
        </div>

        <button class="btn-ef-secondary" style="padding: 0.45rem 0.85rem; font-size: 0.825rem;" @onclick="RefreshBaselineAsync" title="Làm mới số liệu">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Đồng bộ</span>
        </button>
    </div>
</div>

<!-- 6 KPI Metric Cards Grid -->
<div class="kpi-grid">
    <!-- 1. Total Events -->
    <div class="kpi-card">
        <div>
            <div class="kpi-title">Tổng số sự kiện</div>
            <div class="kpi-value">@stats.TotalEvents</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">Sự kiện trên hệ thống</div>
        </div>
        <div class="kpi-icon-wrapper" style="background-color: var(--primary-light); color: var(--primary);">
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
        </div>
    </div>

    <!-- 2. Total Registrations -->
    <div class="kpi-card">
        <div>
            <div class="kpi-title">Tổng lượt đăng ký</div>
            <div class="kpi-value" style="color: var(--primary);">@stats.TotalRegistrations</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">Vé đang hoạt động</div>
        </div>
        <div class="kpi-icon-wrapper" style="background-color: var(--primary-light); color: var(--primary);">
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
            </svg>
        </div>
    </div>

    <!-- 3. Total Checked In -->
    <div class="kpi-card">
        <div>
            <div class="kpi-title">Đã Check-in</div>
            <div class="kpi-value" style="color: var(--success);">@stats.TotalCheckedIn</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">Có mặt tại sự kiện</div>
        </div>
        <div class="kpi-icon-wrapper" style="background-color: var(--success-light); color: var(--success);">
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
    </div>

    <!-- 4. Total Not Checked In -->
    <div class="kpi-card">
        <div>
            <div class="kpi-title">Chưa Check-in</div>
            <div class="kpi-value" style="color: var(--warning);">@stats.TotalNotCheckedIn</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">Chưa đến quầy vé</div>
        </div>
        <div class="kpi-icon-wrapper" style="background-color: var(--warning-light); color: var(--warning);">
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
    </div>

    <!-- 5. Remaining Capacity -->
    <div class="kpi-card">
        <div>
            <div class="kpi-title">Số chỗ còn lại</div>
            <div class="kpi-value">@stats.TotalRemainingSpots</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">Tổng toàn bộ sự kiện</div>
        </div>
        <div class="kpi-icon-wrapper" style="background-color: #F1F5F9; color: var(--text-secondary);">
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
        </div>
    </div>

    <!-- 6. Overall Check-in Rate -->
    <div class="kpi-card">
        <div>
            <div class="kpi-title">Tỷ lệ Check-in</div>
            <div class="kpi-value" style="color: var(--primary);">@stats.OverallCheckInRate%</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">Tỷ lệ người đến sự kiện</div>
        </div>
        <div class="kpi-icon-wrapper" style="background-color: var(--primary-light); color: var(--primary);">
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
        </div>
    </div>
</div>

<!-- Realtime Activity Stream -->
<div class="card-modern">
    <div class="card-header-modern">
        <div style="display: flex; align-items: center; gap: 0.6rem;">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--primary);">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0;">Luồng Hoạt động Thời gian thực (Realtime Feed)</h2>
        </div>
        <div style="font-size: 0.75rem; color: var(--text-muted);">
            Cập nhật tự động không cần F5
        </div>
    </div>

    @if (stats.RecentActivities.Count == 0)
    {
        <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
            <p style="font-size: 0.875rem;">Chưa có hoạt động đăng ký hoặc check-in nào trong phiên làm việc này.</p>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            @foreach (var act in stats.RecentActivities)
            {
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.85rem 1rem; background-color: var(--background); border: 1px solid var(--border); border-radius: var(--radius-sm); transition: background-color 0.2s ease;">
                    <div style="display: flex; align-items: center; gap: 0.85rem;">
                        <span class="badge-modern @GetActivityBadgeClass(act.EventType)">
                            @GetActivityTypeName(act.EventType)
                        </span>
                        <div>
                            <div style="font-size: 0.875rem; font-weight: 500; color: var(--text-primary);">
                                @act.Description
                            </div>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">
                                Sự kiện: <strong>@act.EventName</strong> | Mã truy vết (Correlation): @act.CorrelationId
                            </div>
                        </div>
                    </div>
                    <div style="font-size: 0.775rem; color: var(--text-secondary); white-space: nowrap;">
                        @act.Timestamp.ToString("HH:mm:ss")
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private DashboardStatsDto stats = new();
    private bool isConnected = false;

    protected override async Task OnInitializedAsync()
    {
        // 1. Fetch initial baseline stats from EventApi
        stats = await EventApi.GetDashboardStatsAsync();

        // 2. Register SignalR callbacks
        SignalRClient.OnStatsReceived += HandleStatsReceived;
        SignalRClient.OnActivityReceived += HandleActivityReceived;
        SignalRClient.OnConnectionStatusChanged += HandleConnectionStatusChanged;

        // 3. Connect to SignalR hub
        await SignalRClient.StartAsync();
        isConnected = SignalRClient.IsConnected;
    }

    private void HandleStatsReceived(DashboardStatsDto newStats)
    {
        stats = newStats;
        InvokeAsync(StateHasChanged);
    }

    private void HandleActivityReceived(ActivityLogDto activity)
    {
        stats.RecentActivities.Insert(0, activity);
        if (stats.RecentActivities.Count > 20)
        {
            stats.RecentActivities.RemoveAt(stats.RecentActivities.Count - 1);
        }
        InvokeAsync(StateHasChanged);
    }

    private void HandleConnectionStatusChanged(bool status)
    {
        isConnected = status;
        InvokeAsync(StateHasChanged);
    }

    private async Task RefreshBaselineAsync()
    {
        stats = await EventApi.GetDashboardStatsAsync();
    }

    private static string GetActivityBadgeClass(string eventType) => eventType switch
    {
        "ParticipantRegistered" => "badge-primary",
        "ParticipantCheckedIn" => "badge-success",
        "ParticipantCancelled" => "badge-danger",
        _ => "badge-secondary"
    };

    private static string GetActivityTypeName(string eventType) => eventType switch
    {
        "ParticipantRegistered" => "Đăng ký mới",
        "ParticipantCheckedIn" => "Check-in",
        "ParticipantCancelled" => "Hủy vé",
        _ => eventType
    };

    public async ValueTask DisposeAsync()
    {
        SignalRClient.OnStatsReceived -= HandleStatsReceived;
        SignalRClient.OnActivityReceived -= HandleActivityReceived;
        SignalRClient.OnConnectionStatusChanged -= HandleConnectionStatusChanged;
        await Task.CompletedTask;
    }
}
