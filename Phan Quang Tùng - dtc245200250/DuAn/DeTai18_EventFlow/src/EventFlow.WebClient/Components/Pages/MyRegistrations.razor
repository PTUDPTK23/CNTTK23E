@page "/my-registrations"
@rendermode InteractiveServer
@inject EventApiClient EventApi

<PageTitle>Tra cứu Vé của tôi - EventFlow</PageTitle>

<div style="max-width: 760px; margin: 0 auto;">
    <div class="card-modern mb-4">
        <h1 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.4rem;">Tra cứu Vé & Hủy Đăng ký</h1>
        <p style="font-size: 0.875rem; margin-bottom: 1.25rem;">
            Nhập mã đăng ký (Registration Code) in trên vé điện tử của bạn để tra cứu thông tin hoặc thao tác hủy đăng ký.
        </p>

        <div style="display: flex; gap: 0.75rem;">
            <input type="text" class="form-control-ef" placeholder="Nhập mã vé, ví dụ: EVT-123456"
                   @bind="searchCode" @bind:event="oninput" @onkeyup="HandleKeyUp" />
            <button class="btn-ef-primary" @onclick="SearchTicketAsync" disabled="@isSearching">
                @if (isSearching)
                {
                    <span>Đang tìm...</span>
                }
                else
                {
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <span>Tra cứu</span>
                }
            </button>
        </div>

        @if (!string.IsNullOrEmpty(alertMessage))
        {
            <div class="mt-3" style="background-color: var(--danger-light); color: var(--danger); border: 1px solid #FECACA; border-radius: var(--radius-sm); padding: 0.75rem; font-size: 0.85rem;">
                @alertMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="mt-3" style="background-color: var(--success-light); color: var(--success); border: 1px solid #BBF7D0; border-radius: var(--radius-sm); padding: 0.75rem; font-size: 0.85rem;">
                @successMessage
            </div>
        }
    </div>

    @if (ticket != null)
    {
        <div class="card-modern mb-4">
            <div class="card-header-modern">
                <div>
                    <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">Thông tin vé</span>
                    <h2 style="font-size: 1.25rem; font-weight: 700; margin-top: 0.2rem;">@ticket.EventName</h2>
                </div>
                <span class="badge-modern @GetStatusBadgeClass(ticket.Status)">
                    @GetStatusName(ticket.Status)
                </span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 180px; gap: 1.5rem; align-items: center; margin-bottom: 1.5rem;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; font-size: 0.875rem;">
                    <div>
                        <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">Mã đăng ký</span>
                        <strong style="color: var(--primary); font-family: monospace; font-size: 1.1rem;">@ticket.RegistrationCode</strong>
                    </div>
                    <div>
                        <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">Người tham dự</span>
                        <strong style="color: var(--text-primary);">@ticket.ParticipantName</strong>
                    </div>
                    <div>
                        <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">Email</span>
                        <span>@ticket.ParticipantEmail</span>
                    </div>
                    <div>
                        <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">Số điện thoại</span>
                        <span>@(string.IsNullOrEmpty(ticket.ParticipantPhone) ? "Chưa cập nhật" : ticket.ParticipantPhone)</span>
                    </div>
                    <div>
                        <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">Thời gian bắt đầu</span>
                        <span>@ticket.EventStartTime.ToString("HH:mm - dd/MM/yyyy")</span>
                    </div>
                    <div>
                        <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">Thời điểm đăng ký</span>
                        <span>@ticket.RegisteredAt.ToString("HH:mm dd/MM/yyyy")</span>
                    </div>
                    @if (ticket.CheckedInAt.HasValue)
                    {
                        <div style="grid-column: span 2;">
                            <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">Thời điểm check-in</span>
                            <span style="color: var(--success); font-weight: 600;">@ticket.CheckedInAt.Value.ToString("HH:mm:ss dd/MM/yyyy")</span>
                        </div>
                    }
                    @if (ticket.CancelledAt.HasValue)
                    {
                        <div style="grid-column: span 2;">
                            <span style="color: var(--text-muted); font-size: 0.75rem; display: block;">Thời điểm hủy vé</span>
                            <span style="color: var(--danger); font-weight: 600;">@ticket.CancelledAt.Value.ToString("HH:mm:ss dd/MM/yyyy")</span>
                        </div>
                    }
                </div>

                <div style="text-align: center; border-left: 1px dashed var(--border); padding-left: 1rem;">
                    @((MarkupString)QrCodeHelper.GenerateSvgQr(ticket.RegistrationCode, 140))
                    <div style="font-size: 0.725rem; color: var(--text-muted); margin-top: 0.35rem;">QR Check-in</div>
                </div>
            </div>

            <!-- Cancellation action -->
            @if (ticket.Status == RegistrationStatus.Confirmed)
            {
                <div style="border-top: 1px solid var(--border-subtle); padding-top: 1.25rem; display: flex; justify-content: flex-end;">
                    <button class="btn-ef-danger" @onclick="() => showConfirmModal = true">
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        <span>Hủy Đăng ký này</span>
                    </button>
                </div>
            }
            else if (ticket.Status == RegistrationStatus.CheckedIn)
            {
                <div style="border-top: 1px solid var(--border-subtle); padding-top: 1rem; font-size: 0.85rem; color: var(--text-secondary);">
                    Vé này đã hoàn tất check-in, không thể hủy.
                </div>
            }
            else if (ticket.Status == RegistrationStatus.Cancelled)
            {
                <div style="border-top: 1px solid var(--border-subtle); padding-top: 1rem; font-size: 0.85rem; color: var(--danger);">
                    Vé này đã bị hủy. Chỗ trống đã được hoàn trả lại cho sự kiện.
                </div>
            }
        </div>
    }
</div>

<!-- Cancellation Confirmation Modal -->
@if (showConfirmModal && ticket != null)
{
    <div style="position: fixed; inset: 0; background: rgba(15, 23, 42, 0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
        <div class="card-modern" style="max-width: 480px; width: 100%; box-shadow: var(--shadow-lg);">
            <div style="display: flex; gap: 0.85rem; align-items: flex-start; margin-bottom: 1.25rem;">
                <div style="width: 40px; height: 40px; border-radius: 50%; background-color: var(--danger-light); color: var(--danger); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <div>
                    <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.4rem;">Xác nhận hủy đăng ký?</h3>
                    <p style="font-size: 0.85rem; margin-bottom: 0;">
                        Bạn có chắc chắn muốn hủy lượt đăng ký cho sự kiện <strong>@ticket.EventName</strong> (Mã vé: <strong>@ticket.RegistrationCode</strong>)? Thao tác này không thể hoàn tác. Chỗ trống sẽ được nhường lại cho người khác.
                    </p>
                </div>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
                <button class="btn-ef-secondary" @onclick="() => showConfirmModal = false" disabled="@isCancelling">
                    Đóng
                </button>
                <button class="btn-ef-danger" @onclick="ConfirmCancelAsync" disabled="@isCancelling">
                    @if (isCancelling)
                    {
                        <span>Đang xử lý...</span>
                    }
                    else
                    {
                        <span>Đồng ý Hủy</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string searchCode = string.Empty;
    private RegistrationDetailDto? ticket;
    private bool isSearching = false;
    private bool isCancelling = false;
    private bool showConfirmModal = false;
    private string? alertMessage;
    private string? successMessage;

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchTicketAsync();
        }
    }

    private async Task SearchTicketAsync()
    {
        alertMessage = null;
        successMessage = null;
        if (string.IsNullOrWhiteSpace(searchCode))
        {
            alertMessage = "Vui lòng nhập mã vé đăng ký.";
            return;
        }

        isSearching = true;
        try
        {
            ticket = await EventApi.GetRegistrationByCodeAsync(searchCode.Trim());
            if (ticket == null)
            {
                alertMessage = $"Không tìm thấy vé với mã '{searchCode.Trim()}'. Vui lòng kiểm tra lại.";
            }
        }
        finally
        {
            isSearching = false;
        }
    }

    private async Task ConfirmCancelAsync()
    {
        if (ticket == null) return;

        isCancelling = true;
        try
        {
            var (success, msg) = await EventApi.CancelRegistrationAsync(ticket.Id);
            if (success)
            {
                showConfirmModal = false;
                successMessage = "Hủy đăng ký thành công! Chỗ trống đã được hoàn trả lại cho sự kiện.";
                // Reload ticket state
                ticket = await EventApi.GetRegistrationByCodeAsync(ticket.RegistrationCode);
            }
            else
            {
                alertMessage = msg;
            }
        }
        finally
        {
            isCancelling = false;
        }
    }

    private static string GetStatusBadgeClass(RegistrationStatus status) => status switch
    {
        RegistrationStatus.Confirmed => "badge-primary",
        RegistrationStatus.CheckedIn => "badge-success",
        RegistrationStatus.Cancelled => "badge-danger",
        _ => "badge-secondary"
    };

    private static string GetStatusName(RegistrationStatus status) => status switch
    {
        RegistrationStatus.Confirmed => "Đã xác nhận",
        RegistrationStatus.CheckedIn => "Đã check-in",
        RegistrationStatus.Cancelled => "Đã hủy",
        _ => "Không rõ"
    };
}
