# EventFlow - Environment Configuration Example

# Database (PostgreSQL)
POSTGRES_DB=eventflow_db
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=eventflow_password
POSTGRES_PORT=5432

# Message Broker (RabbitMQ)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Service Ports
EVENT_API_PORT=5000
DASHBOARD_SERVICE_PORT=5001
AUDIT_WORKER_PORT=5002
WEB_CLIENT_PORT=5003
