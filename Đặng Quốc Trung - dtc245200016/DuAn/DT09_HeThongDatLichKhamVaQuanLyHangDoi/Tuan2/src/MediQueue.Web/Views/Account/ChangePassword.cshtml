@model ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<section class="account-page">
    <div class="container app-container narrow-page">
        <a class="back-link" asp-action="Profile"><svg aria-hidden="true"><use href="/images/icons.svg#chevron-left"></use></svg>Quay lại hồ sơ</a>
        <div class="page-heading"><span class="eyebrow">Bảo mật tài khoản</span><h1>Đổi mật khẩu</h1><p>Sau khi cập nhật thành công, các phiên đăng nhập hiện tại sẽ kết thúc và bạn cần đăng nhập lại.</p></div>
        <form asp-action="ChangePassword" method="post" class="surface-card app-form password-form" data-secure-form>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="field-group"><label asp-for="CurrentPassword"></label><div class="input-shell"><svg aria-hidden="true"><use href="/images/icons.svg#lock"></use></svg><input asp-for="CurrentPassword" autocomplete="current-password" data-password-input autofocus /><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false"><svg aria-hidden="true"><use href="/images/icons.svg#eye"></use></svg></button></div><span asp-validation-for="CurrentPassword" class="field-validation"></span></div>
            <div class="field-group"><label asp-for="NewPassword"></label><div class="input-shell"><svg aria-hidden="true"><use href="/images/icons.svg#key"></use></svg><input asp-for="NewPassword" autocomplete="new-password" data-password-input data-password-strength /><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false"><svg aria-hidden="true"><use href="/images/icons.svg#eye"></use></svg></button></div><span asp-validation-for="NewPassword" class="field-validation"></span><div class="password-checklist" data-password-checklist aria-live="polite"><span data-check="length"><svg aria-hidden="true"><use href="/images/icons.svg#check"></use></svg>Ít nhất 12 ký tự</span><span data-check="unique"><svg aria-hidden="true"><use href="/images/icons.svg#check"></use></svg>Ít nhất 3 ký tự khác nhau</span></div></div>
            <div class="field-group"><label asp-for="ConfirmNewPassword"></label><div class="input-shell"><svg aria-hidden="true"><use href="/images/icons.svg#key"></use></svg><input asp-for="ConfirmNewPassword" autocomplete="new-password" data-password-input /><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false"><svg aria-hidden="true"><use href="/images/icons.svg#eye"></use></svg></button></div><span asp-validation-for="ConfirmNewPassword" class="field-validation"></span></div>
            <button class="btn btn-primary" type="submit" data-submit-button><span data-button-label>Cập nhật mật khẩu</span><span class="button-spinner" aria-hidden="true"></span></button><partial name="_FormStatus" />
        </form>
    </div>
</section>
