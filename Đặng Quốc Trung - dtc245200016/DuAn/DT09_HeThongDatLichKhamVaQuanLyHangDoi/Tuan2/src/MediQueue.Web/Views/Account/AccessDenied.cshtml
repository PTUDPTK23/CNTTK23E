@{ ViewData["Title"] = "Không có quyền truy cập"; }
<section class="status-page"><div class="status-card"><div class="status-icon status-icon--warning"><svg aria-hidden="true"><use href="/images/icons.svg#shield"></use></svg></div><span class="eyebrow">Khu vực được bảo vệ</span><h1>Bạn chưa có quyền truy cập</h1><p>Nội dung này chưa phù hợp với quyền của tài khoản đang đăng nhập. Bạn có thể quay lại hồ sơ hoặc trang chủ để tiếp tục.</p><div class="status-actions"><a class="btn btn-primary" asp-action="Profile">Về hồ sơ</a><a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Trang chủ</a></div></div></section>
