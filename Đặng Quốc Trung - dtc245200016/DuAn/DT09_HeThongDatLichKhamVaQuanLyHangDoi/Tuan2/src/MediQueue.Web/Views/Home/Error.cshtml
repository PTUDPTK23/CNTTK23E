@model ErrorViewModel
@{ ViewData["Title"] = "Có điều gì đó chưa ổn"; }
<section class="status-page"><div class="status-card"><div class="status-icon status-icon--error"><svg aria-hidden="true"><use href="/images/icons.svg#heart-pulse"></use></svg></div><span class="eyebrow">MediQueue đang cần một nhịp nghỉ</span><h1>Chúng tôi chưa thể hoàn tất yêu cầu</h1><p>Dịch vụ có thể đang tạm gián đoạn. Không có quyền truy cập nào được bỏ qua; vui lòng thử lại sau ít phút.</p>@if (Model.ShowRequestId){<p class="request-id">Mã hỗ trợ: <code>@Model.RequestId</code></p>}<div class="status-actions"><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a><button class="btn btn-secondary" type="button" onclick="window.location.reload()">Thử lại</button></div></div></section>
