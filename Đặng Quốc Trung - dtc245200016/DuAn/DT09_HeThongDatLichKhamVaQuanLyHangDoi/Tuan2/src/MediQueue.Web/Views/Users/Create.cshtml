@model CreateStaffViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Tạo tài khoản nhân sự"; }
<div class="dashboard-page users-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Tài khoản mới</span><h1>Tạo tài khoản nhân sự</h1><p>Chỉ tạo tài khoản Bác sĩ hoặc Lễ tân. Hồ sơ chuyên môn được quản lý ở module riêng.</p></div></header>
<section class="user-form-card"><form method="post" data-loading-form>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field-group field-span-2"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName"></span></div><div class="field-group"><label asp-for="Email"></label><input asp-for="Email" autocomplete="off" /><span asp-validation-for="Email"></span></div><div class="field-group"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" autocomplete="tel" /><span asp-validation-for="PhoneNumber"></span></div><div class="field-group"><label asp-for="Role"></label><select asp-for="Role"><option value="Doctor">Bác sĩ</option><option value="Receptionist">Lễ tân</option></select><span asp-validation-for="Role"></span></div><div class="field-group"><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><small>Ít nhất 12 ký tự và 3 ký tự khác nhau.</small><span asp-validation-for="Password"></span></div><div class="field-group field-span-2"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div></div><div class="form-actions"><a class="btn btn-ghost" asp-action="Index">Hủy</a><button class="btn btn-primary" type="submit" data-loading-text="Đang tạo...">Tạo tài khoản</button></div></form></section></div>
