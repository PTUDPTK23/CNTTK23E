@model UserDetailsResponse
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Chi tiết tài khoản"; string initials = string.Concat(Model.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x => char.ToUpperInvariant(x[0]))); bool isStaff = UserManagementValues.StaffRoles.Contains(Model.Role, StringComparer.Ordinal); }
<div class="dashboard-page users-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Chi tiết tài khoản</span><h1>@Model.DisplayName</h1><p>Thông tin định danh tối thiểu và trạng thái truy cập hiện tại.</p></div>@if(isStaff){<a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Chỉnh sửa thông tin</a>}</header>
<div class="user-detail-grid"><section class="user-profile-card"><span class="user-profile-avatar">@initials</span><h2>@Model.DisplayName</h2><p>@Model.Email</p><span class="role-badge role-badge--@Model.Role.ToLowerInvariant()">@RolePresentation.GetLabel(Model.Role)</span></section><section class="user-detail-card"><h2>Thông tin tài khoản</h2><dl><div><dt>Số điện thoại</dt><dd>@(Model.PhoneNumber ?? "Chưa cập nhật")</dd></div><div><dt>Ngày tạo</dt><dd>@Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Hồ sơ nghiệp vụ</dt><dd>@(Model.HasDomainProfile ? "Đã liên kết" : "Chưa liên kết")</dd></div><div><dt>Trạng thái hoạt động</dt><dd><span class="status-badge @(Model.IsActive ? "is-active" : "is-inactive")">@(Model.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")</span></dd></div><div><dt>Đăng nhập</dt><dd><span class="status-badge @(Model.IsLockedOut ? "is-locked" : "is-active")">@(Model.IsLockedOut ? "Đang bị khóa" : "Bình thường")</span></dd></div></dl></section></div>
@if(Model.Role != "Admin") { <section class="account-actions-card"><div><h2>Kiểm soát truy cập</h2><p>Thay đổi trạng thái sẽ thu hồi các phiên đăng nhập hiện tại.</p></div><div class="account-action-buttons">@if(Model.IsLockedOut){<form method="post" asp-action="Unlock" asp-route-id="@Model.Id" data-confirm-form data-confirm-title="Mở khóa đăng nhập?" data-confirm-message="Tài khoản sẽ có thể đăng nhập lại nếu đang hoạt động.">@Html.AntiForgeryToken()<button class="btn btn-secondary" type="submit">Mở khóa</button></form>}@if(Model.IsActive){<form method="post" asp-action="Deactivate" asp-route-id="@Model.Id" data-confirm-form data-confirm-title="Ngừng hoạt động tài khoản?" data-confirm-message="Người dùng sẽ bị đăng xuất và không thể đăng nhập cho đến khi được kích hoạt lại.">@Html.AntiForgeryToken()<button class="btn btn-danger-soft" type="submit">Ngừng hoạt động</button></form>}else{<form method="post" asp-action="Activate" asp-route-id="@Model.Id" data-confirm-form data-confirm-title="Kích hoạt lại tài khoản?" data-confirm-message="Tài khoản sẽ được phép đăng nhập trở lại bằng mật khẩu hiện tại.">@Html.AntiForgeryToken()<button class="btn btn-primary" type="submit">Kích hoạt lại</button></form>}</div></section> }
<dialog class="confirm-dialog" data-confirm-dialog><form method="dialog"><span class="confirm-dialog__icon" aria-hidden="true">!</span><h2 data-confirm-heading>Xác nhận thao tác</h2><p data-confirm-copy></p><div><button class="btn btn-ghost" value="cancel">Hủy</button><button class="btn btn-primary" value="confirm">Xác nhận</button></div></form></dialog></div>
