@model UsersIndexViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Quản lý người dùng";
    PagedUsersResponse data = Model.Results;
}
<div class="dashboard-page users-page">
    <header class="dashboard-page-heading">
        <div><span class="eyebrow">Quản trị tài khoản</span><h1>Quản lý người dùng</h1><p>Theo dõi trạng thái và quản trị tài khoản nhân sự trong phạm vi an toàn.</p></div>
        <a class="btn btn-primary" asp-action="Create"><svg aria-hidden="true"><use href="/images/icons.svg#user-check"></use></svg>Tạo tài khoản nhân sự</a>
    </header>
    <section class="user-stat-grid" aria-label="Thống kê tài khoản">
        <article><span>Tổng tài khoản</span><strong>@data.Summary.Total</strong></article>
        <article class="is-success"><span>Đang hoạt động</span><strong>@data.Summary.Active</strong></article>
        <article class="is-muted"><span>Đã vô hiệu hóa</span><strong>@data.Summary.Inactive</strong></article>
        <article class="is-warning"><span>Khóa đăng nhập</span><strong>@data.Summary.LockedOut</strong></article>
    </section>
    <section class="users-panel">
        <form method="get" class="users-filter" role="search">
            <label class="filter-search"><span class="visually-hidden">Tìm kiếm</span><input name="search" value="@Model.Query.Search" placeholder="Tìm theo họ tên hoặc email" /></label>
            <select name="role" aria-label="Lọc theo vai trò"><option value="">Tất cả vai trò</option><option value="Admin" selected="@(Model.Query.Role == "Admin")">Quản trị viên</option><option value="Doctor" selected="@(Model.Query.Role == "Doctor")">Bác sĩ</option><option value="Receptionist" selected="@(Model.Query.Role == "Receptionist")">Lễ tân</option><option value="Patient" selected="@(Model.Query.Role == "Patient")">Bệnh nhân</option></select>
            <select name="status" aria-label="Lọc theo trạng thái"><option value="">Mọi trạng thái</option><option value="active" selected="@(Model.Query.Status == "active")">Đang hoạt động</option><option value="inactive" selected="@(Model.Query.Status == "inactive")">Đã vô hiệu hóa</option></select>
            <select name="lockout" aria-label="Lọc khóa đăng nhập"><option value="">Mọi tình trạng đăng nhập</option><option value="locked" selected="@(Model.Query.Lockout == "locked")">Đang bị khóa</option><option value="unlocked" selected="@(Model.Query.Lockout == "unlocked")">Không bị khóa</option></select>
            <input type="hidden" name="sortBy" value="@Model.Query.SortBy" /><input type="hidden" name="sortDirection" value="@Model.Query.SortDirection" />
            <select name="pageSize" aria-label="Số dòng mỗi trang"><option value="10" selected="@(Model.Query.PageSize == 10)">10 / trang</option><option value="20" selected="@(Model.Query.PageSize == 20)">20 / trang</option><option value="50" selected="@(Model.Query.PageSize == 50)">50 / trang</option></select>
            <button class="btn btn-secondary" type="submit">Áp dụng</button><a class="btn btn-ghost" asp-action="Index">Đặt lại</a>
        </form>
        @if (data.Items.Count == 0)
        {
            <div class="users-empty"><svg aria-hidden="true"><use href="/images/icons.svg#users"></use></svg><h2>Chưa có tài khoản phù hợp</h2><p>Hãy điều chỉnh bộ lọc hoặc tạo tài khoản nhân sự mới.</p></div>
        }
        else
        {
            <div class="users-table-wrap"><table class="users-table"><thead><tr><th>Người dùng</th><th>Vai trò</th><th>Trạng thái</th><th>Ngày tạo</th><th><span class="visually-hidden">Thao tác</span></th></tr></thead><tbody>
            @foreach (UserListItemResponse item in data.Items)
            {
                string initials = string.Concat(item.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x => char.ToUpperInvariant(x[0])));
                <tr><td data-label="Người dùng"><div class="user-cell"><span class="user-avatar">@initials</span><span><strong>@item.DisplayName</strong><small>@item.Email</small></span></div></td><td data-label="Vai trò"><span class="role-badge role-badge--@item.Role.ToLowerInvariant()">@RolePresentation.GetLabel(item.Role)</span></td><td data-label="Trạng thái"><div class="status-stack"><span class="status-badge @(item.IsActive ? "is-active" : "is-inactive")">@(item.IsActive ? "Đang hoạt động" : "Đã vô hiệu hóa")</span>@if(item.IsLockedOut){<span class="status-badge is-locked">Khóa đăng nhập</span>}</div></td><td data-label="Ngày tạo">@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</td><td class="table-actions"><a class="icon-action" asp-action="Details" asp-route-id="@item.Id" aria-label="Xem chi tiết @item.DisplayName">•••</a></td></tr>
            }
            </tbody></table></div>
            <nav class="users-pagination" aria-label="Phân trang"><span>Hiển thị @data.Items.Count / @data.TotalCount tài khoản</span><div>@if(data.Page > 1){<a asp-all-route-data='new Dictionary<string,string?> { ["search"]=Model.Query.Search,["role"]=Model.Query.Role,["status"]=Model.Query.Status,["lockout"]=Model.Query.Lockout,["sortBy"]=Model.Query.SortBy,["sortDirection"]=Model.Query.SortDirection,["pageSize"]=Model.Query.PageSize.ToString(),["page"]=(data.Page-1).ToString() }'>Trước</a>}<strong>Trang @data.Page / @Math.Max(data.TotalPages, 1)</strong>@if(data.Page < data.TotalPages){<a asp-all-route-data='new Dictionary<string,string?> { ["search"]=Model.Query.Search,["role"]=Model.Query.Role,["status"]=Model.Query.Status,["lockout"]=Model.Query.Lockout,["sortBy"]=Model.Query.SortBy,["sortDirection"]=Model.Query.SortDirection,["pageSize"]=Model.Query.PageSize.ToString(),["page"]=(data.Page+1).ToString() }'>Sau</a>}</div></nav>
        }
    </section>
</div>
