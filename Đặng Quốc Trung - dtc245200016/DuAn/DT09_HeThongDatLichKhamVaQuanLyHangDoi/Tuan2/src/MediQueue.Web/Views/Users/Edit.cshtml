@model EditStaffViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Chỉnh sửa nhân sự"; }
<div class="dashboard-page users-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Thông tin nhân sự</span><h1>Chỉnh sửa tài khoản</h1><p>Email và vai trò được khóa để bảo toàn định danh tài khoản.</p></div></header><section class="user-form-card"><form method="post" data-loading-form>@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field-group"><label>Email</label><input asp-for="Email" readonly /><small>Không thể thay đổi trong module này.</small></div><div class="field-group"><label>Vai trò</label><input value="@RolePresentation.GetLabel(Model.Role)" readonly /><input asp-for="Role" type="hidden" /></div><div class="field-group field-span-2"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName"></span></div><div class="field-group field-span-2"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" autocomplete="tel" /><span asp-validation-for="PhoneNumber"></span></div></div><div class="form-actions"><a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Hủy</a><button class="btn btn-primary" type="submit" data-loading-text="Đang lưu...">Lưu thay đổi</button></div></form></section></div>
