@model DoctorDetailsResponse
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Chi tiết bác sĩ"; var initials = string.Concat(Model.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x => x[0])).ToUpperInvariant(); }
<div class="dashboard-page catalog-page profile-management-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Bác sĩ · @Model.DepartmentCode</span><h1>@Model.DisplayName</h1><p>Hồ sơ chuyên môn được liên kết duy nhất với tài khoản đăng nhập.</p></div><a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Chỉnh sửa</a></header>
<div class="catalog-detail-grid"><section class="catalog-identity"><span class="catalog-monogram" aria-hidden="true">@initials</span><h2>@Model.DisplayName</h2><span class="profile-specialty">@Model.DepartmentName</span><span class="status-badge @((Model.ProfileIsActive && Model.AccountIsActive) ? "is-active" : "is-inactive")">@((Model.ProfileIsActive && Model.AccountIsActive) ? "Đang hoạt động" : "Không hoạt động")</span></section>
<section class="catalog-detail-card"><h2>Thông tin liên kết</h2><dl class="profile-detail-list"><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Số điện thoại</dt><dd>@(Model.PhoneNumber ?? "Chưa cập nhật")</dd></div><div><dt>Chuyên khoa</dt><dd>@Model.DepartmentName</dd></div><div><dt>Ngày tạo tài khoản</dt><dd>@Model.AccountCreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</dd></div></dl><p class="catalog-note">Mật khẩu và vai trò được quản lý riêng tại chức năng tài khoản người dùng.</p></section></div></div>
