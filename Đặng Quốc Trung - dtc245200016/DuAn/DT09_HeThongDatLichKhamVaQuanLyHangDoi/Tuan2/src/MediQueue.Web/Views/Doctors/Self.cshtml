@model DoctorSelfProfileResponse
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Hồ sơ chuyên môn"; }
<div class="dashboard-page catalog-page profile-management-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Không gian bác sĩ</span><h1>Hồ sơ chuyên môn</h1><p>Thông tin chuyên khoa được quản trị viên xác nhận cho tài khoản của bạn.</p></div></header>
@if (!Model.HasProfile || Model.Profile is null) { <div class="catalog-empty catalog-panel"><span aria-hidden="true">＋</span><h2>Chưa có hồ sơ bác sĩ liên kết</h2><p>Vui lòng liên hệ quản trị viên để hoàn tất hồ sơ chuyên môn.</p><a class="btn btn-secondary" asp-controller="Dashboard" asp-action="Index">Về tổng quan</a></div> }
else { var p = Model.Profile; <div class="catalog-detail-grid"><section class="catalog-identity"><span class="catalog-monogram" aria-hidden="true">BS</span><h2>@p.DisplayName</h2><span class="profile-specialty">@p.DepartmentName</span><span class="status-badge @((p.ProfileIsActive && p.AccountIsActive) ? "is-active" : "is-inactive")">@((p.ProfileIsActive && p.AccountIsActive) ? "Đang hoạt động" : "Không hoạt động")</span></section><section class="catalog-detail-card"><h2>Thông tin của tôi</h2><dl class="profile-detail-list"><div><dt>Email</dt><dd>@p.Email</dd></div><div><dt>Số điện thoại</dt><dd>@(p.PhoneNumber ?? "Chưa cập nhật")</dd></div><div><dt>Mã chuyên khoa</dt><dd>@p.DepartmentCode</dd></div><div><dt>Chuyên khoa</dt><dd>@p.DepartmentName</dd></div></dl><p class="catalog-note">Liên hệ quản trị viên nếu thông tin chuyên môn cần điều chỉnh.</p></section></div> }
</div>
