<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2563eb" />
    <title>@ViewData["Title"] · MediQueue</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user-management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalog-management.css" asp-append-version="true" />
</head>
<body class="dashboard-body role-@RolePresentation.GetAccentClass(User.FindFirstValue(ClaimTypes.Role))" data-dashboard-shell>
    <a class="skip-link" href="#main-content">Bỏ qua đến nội dung chính</a>
    <div class="dashboard-shell">
        <partial name="_DashboardSidebar" />
        <div class="dashboard-overlay" data-sidebar-overlay aria-hidden="true"></div>
        <div class="dashboard-workspace">
            <partial name="_DashboardHeader" />
            <partial name="_ToastMessages" />
            <main id="main-content" class="dashboard-main page-enter" tabindex="-1">
                <div class="dashboard-container">
                    <partial name="_DashboardBreadcrumb" />
                    @RenderBody()
                </div>
            </main>
            <footer class="dashboard-footer">
                <span>© 2026 MediQueue</span>
                <span>Không gian chăm sóc sức khỏe an toàn và rõ ràng.</span>
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/user-management.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
