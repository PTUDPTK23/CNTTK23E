@{
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    string current = controller.Equals("Dashboard", StringComparison.OrdinalIgnoreCase)
        ? "Tổng quan"
        : controller.Equals("Users", StringComparison.OrdinalIgnoreCase)
            ? action switch { "Create" => "Tạo tài khoản", "Edit" => "Chỉnh sửa nhân sự", "Details" => "Chi tiết tài khoản", _ => "Quản lý người dùng" }
        : controller.Equals("Departments", StringComparison.OrdinalIgnoreCase)
            ? action switch { "Create" => "Thêm chuyên khoa", "Edit" => "Chỉnh sửa chuyên khoa", "Details" => "Chi tiết chuyên khoa", _ => "Quản lý chuyên khoa" }
        : controller.Equals("Rooms", StringComparison.OrdinalIgnoreCase)
            ? action switch { "Create" => "Thêm phòng khám", "Edit" => "Chỉnh sửa phòng khám", "Details" => "Chi tiết phòng khám", _ => "Quản lý phòng khám" }
        : action.Equals("ChangePassword", StringComparison.OrdinalIgnoreCase) ? "Đổi mật khẩu" : "Hồ sơ cá nhân";
}
<nav class="dashboard-breadcrumb" aria-label="Đường dẫn trang">
    <a asp-controller="Dashboard" asp-action="Index"><svg aria-hidden="true"><use href="/images/icons.svg#home"></use></svg><span>Tổng quan</span></a>
    @if (!controller.Equals("Dashboard", StringComparison.OrdinalIgnoreCase))
    {
        @if ((controller.Equals("Users", StringComparison.OrdinalIgnoreCase) || controller.Equals("Departments", StringComparison.OrdinalIgnoreCase) || controller.Equals("Rooms", StringComparison.OrdinalIgnoreCase)) && !action.Equals("Index", StringComparison.OrdinalIgnoreCase))
        {
            string parent = controller.Equals("Departments", StringComparison.OrdinalIgnoreCase) ? "Quản lý chuyên khoa" : controller.Equals("Rooms", StringComparison.OrdinalIgnoreCase) ? "Quản lý phòng khám" : "Quản lý người dùng";
            <span aria-hidden="true">/</span><a asp-controller="@controller" asp-action="Index">@parent</a>
        }
        <span aria-hidden="true">/</span><span aria-current="page">@current</span>
    }
</nav>
