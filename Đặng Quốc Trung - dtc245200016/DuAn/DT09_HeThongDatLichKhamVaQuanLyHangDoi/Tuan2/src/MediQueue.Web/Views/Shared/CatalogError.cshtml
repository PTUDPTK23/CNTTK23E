@model CatalogErrorViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = Model.Title; }
<div class="catalog-error" role="alert"><span class="catalog-error__code">@Model.StatusCode</span><h1>@Model.Title</h1><p>@Model.Description</p><div><a class="btn btn-primary" asp-controller="@Model.ReturnController" asp-action="Index">Quay lại danh sách</a><a class="btn btn-ghost" asp-controller="Dashboard" asp-action="Index">Về tổng quan</a></div></div>
