@model DepartmentFormViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Thêm chuyên khoa"; }
<div class="dashboard-page catalog-page catalog-form-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Chuyên khoa</span><h1>Thêm chuyên khoa</h1><p>Tạo danh mục chuyên môn mới cho đội ngũ bác sĩ.</p></div></header><section class="catalog-form-card"><form method="post" data-loading-form>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-field"><label asp-for="Code"></label><input asp-for="Code" autocomplete="off" placeholder="VD: TIMMACH" /><span asp-validation-for="Code"></span><small>Tối đa 32 ký tự, không có khoảng trắng.</small></div><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" autocomplete="off" placeholder="VD: Tim mạch" /><span asp-validation-for="Name"></span></div><div class="catalog-form-actions"><a class="btn btn-ghost" asp-action="Index">Hủy</a><button class="btn btn-primary" type="submit" data-loading-text="Đang lưu...">Tạo chuyên khoa</button></div></form></section></div>
