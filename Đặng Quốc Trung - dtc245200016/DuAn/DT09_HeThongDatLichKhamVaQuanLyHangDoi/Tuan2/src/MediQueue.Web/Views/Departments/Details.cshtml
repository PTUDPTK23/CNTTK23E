@model DepartmentDetailsResponse
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Chi tiết chuyên khoa"; }
<div class="dashboard-page catalog-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Chuyên khoa · @Model.Code</span><h1>@Model.Name</h1><p>Thông tin danh mục và mức độ sử dụng hiện tại.</p></div><a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Chỉnh sửa</a></header><div class="catalog-detail-grid"><section class="catalog-identity"><span class="catalog-monogram" aria-hidden="true">@Model.Code[..Math.Min(2, Model.Code.Length)]</span><strong>@Model.Code</strong><h2>@Model.Name</h2><span class="status-badge @(Model.IsActive ? "is-active" : "is-inactive")">@(Model.IsActive ? "Đang hoạt động" : "Đã vô hiệu hóa")</span></section><section class="catalog-detail-card"><h2>Quan hệ nghiệp vụ</h2><dl><div><dt>Tổng bác sĩ</dt><dd>@Model.DoctorCount</dd></div><div><dt>Bác sĩ đang hoạt động</dt><dd>@Model.ActiveDoctorCount</dd></div></dl><p class="catalog-note">Chuyên khoa chỉ có thể vô hiệu hóa khi không còn bác sĩ đang hoạt động.</p></section></div><section class="catalog-danger-zone"><div><h2>Trạng thái sử dụng</h2><p>Không xóa dữ liệu; bạn có thể kích hoạt lại khi cần.</p></div>@if(Model.IsActive){<form method="post" asp-action="Deactivate" asp-route-id="@Model.Id" data-confirm-form data-confirm-title="Vô hiệu hóa chuyên khoa?" data-confirm-message="Chuyên khoa sẽ không còn sẵn sàng cho dữ liệu mới.">@Html.AntiForgeryToken()<button class="btn btn-danger-soft" type="submit">Vô hiệu hóa</button></form>}else{<form method="post" asp-action="Activate" asp-route-id="@Model.Id" data-confirm-form data-confirm-title="Kích hoạt chuyên khoa?" data-confirm-message="Chuyên khoa sẽ sẵn sàng để sử dụng trở lại.">@Html.AntiForgeryToken()<button class="btn btn-primary" type="submit">Kích hoạt</button></form>}</section><partial name="_CatalogConfirmDialog" /></div>
