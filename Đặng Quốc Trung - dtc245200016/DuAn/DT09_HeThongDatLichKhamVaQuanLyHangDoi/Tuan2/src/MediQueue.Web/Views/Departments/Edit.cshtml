@model DepartmentFormViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Chỉnh sửa chuyên khoa"; }
<div class="dashboard-page catalog-page catalog-form-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Chuyên khoa @Model.Code</span><h1>Chỉnh sửa chuyên khoa</h1><p>Cập nhật mã và tên hiển thị của chuyên khoa.</p></div></header><section class="catalog-form-card"><form method="post" data-loading-form>@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-field"><label asp-for="Code"></label><input asp-for="Code" autocomplete="off" /><span asp-validation-for="Code"></span></div><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" autocomplete="off" /><span asp-validation-for="Name"></span></div><div class="catalog-form-actions"><a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Hủy</a><button class="btn btn-primary" type="submit" data-loading-text="Đang lưu...">Lưu thay đổi</button></div></form></section></div>
