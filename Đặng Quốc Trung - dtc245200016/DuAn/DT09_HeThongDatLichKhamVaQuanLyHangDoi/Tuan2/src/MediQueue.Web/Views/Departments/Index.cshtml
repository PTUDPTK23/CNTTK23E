@model DepartmentsIndexViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Quản lý chuyên khoa"; var data = Model.Results; }
<div class="dashboard-page catalog-page">
  <header class="dashboard-page-heading"><div><span class="eyebrow">Danh mục cơ sở y tế</span><h1>Quản lý chuyên khoa</h1><p>Tổ chức chuyên môn rõ ràng và kiểm soát trạng thái sử dụng an toàn.</p></div><a class="btn btn-primary" asp-action="Create">Thêm chuyên khoa</a></header>
  <section class="catalog-stats" aria-label="Thống kê chuyên khoa"><article><span>Tổng chuyên khoa</span><strong>@data.Summary.Total</strong></article><article class="is-success"><span>Đang hoạt động</span><strong>@data.Summary.Active</strong></article><article class="is-muted"><span>Ngừng hoạt động</span><strong>@data.Summary.Inactive</strong></article></section>
  <section class="catalog-panel">
    <form method="get" class="catalog-filter" role="search"><label><span class="visually-hidden">Tìm chuyên khoa</span><input name="search" value="@Model.Query.Search" placeholder="Tìm theo mã hoặc tên" /></label><select name="status" aria-label="Lọc trạng thái"><option value="">Mọi trạng thái</option><option value="active" selected="@(Model.Query.Status == "active")">Đang hoạt động</option><option value="inactive" selected="@(Model.Query.Status == "inactive")">Ngừng hoạt động</option></select><select name="sortBy" aria-label="Sắp xếp"><option value="code" selected="@(Model.Query.SortBy == "code")">Theo mã</option><option value="name" selected="@(Model.Query.SortBy == "name")">Theo tên</option><option value="status" selected="@(Model.Query.SortBy == "status")">Theo trạng thái</option></select><input type="hidden" name="sortDirection" value="@Model.Query.SortDirection" /><select name="pageSize" aria-label="Số dòng"><option value="10" selected="@(Model.Query.PageSize == 10)">10 / trang</option><option value="20" selected="@(Model.Query.PageSize == 20)">20 / trang</option><option value="50" selected="@(Model.Query.PageSize == 50)">50 / trang</option></select><button class="btn btn-secondary" type="submit">Áp dụng</button><a class="btn btn-ghost" asp-action="Index">Đặt lại</a></form>
    @if (data.Items.Count == 0) { <div class="catalog-empty"><span aria-hidden="true">＋</span><h2>Chưa có chuyên khoa phù hợp</h2><p>Điều chỉnh bộ lọc hoặc thêm chuyên khoa đầu tiên.</p><a class="btn btn-primary" asp-action="Create">Thêm chuyên khoa</a></div> }
    else { <div class="catalog-table-wrap"><table class="catalog-table"><thead><tr><th>Mã</th><th>Tên chuyên khoa</th><th>Bác sĩ</th><th>Trạng thái</th><th><span class="visually-hidden">Thao tác</span></th></tr></thead><tbody>@foreach (var item in data.Items) { <tr><td data-label="Mã"><strong class="catalog-code">@item.Code</strong></td><td data-label="Tên">@item.Name</td><td data-label="Bác sĩ">@item.DoctorCount</td><td data-label="Trạng thái"><span class="status-badge @(item.IsActive ? "is-active" : "is-inactive")">@(item.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")</span></td><td class="catalog-actions"><a class="btn btn-ghost btn-sm" asp-action="Details" asp-route-id="@item.Id">Chi tiết</a></td></tr> }</tbody></table></div>
      <nav class="catalog-pagination" aria-label="Phân trang"><span>Hiển thị @data.Items.Count / @data.TotalCount chuyên khoa</span><div>@if(data.Page > 1){<a asp-action="Index" asp-route-search="@Model.Query.Search" asp-route-status="@Model.Query.Status" asp-route-sortBy="@Model.Query.SortBy" asp-route-sortDirection="@Model.Query.SortDirection" asp-route-pageSize="@Model.Query.PageSize" asp-route-page="@(data.Page-1)">Trước</a>}<strong>Trang @data.Page / @Math.Max(data.TotalPages,1)</strong>@if(data.Page < data.TotalPages){<a asp-action="Index" asp-route-search="@Model.Query.Search" asp-route-status="@Model.Query.Status" asp-route-sortBy="@Model.Query.SortBy" asp-route-sortDirection="@Model.Query.SortDirection" asp-route-pageSize="@Model.Query.PageSize" asp-route-page="@(data.Page+1)">Sau</a>}</div></nav> }
  </section>
</div>
