@model PatientDetailsResponse
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Chi tiết bệnh nhân"; var initials = string.Concat(Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x => x[0])).ToUpperInvariant(); }
<div class="dashboard-page catalog-page profile-management-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Hồ sơ bệnh nhân</span><h1>@Model.FullName</h1><p>Thông tin hành chính từ tài khoản bệnh nhân đã đăng ký.</p></div><a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Chỉnh sửa</a></header><div class="catalog-detail-grid"><section class="catalog-identity"><span class="catalog-monogram patient-monogram" aria-hidden="true">@initials</span><h2>@Model.FullName</h2><span class="status-badge @((Model.ProfileIsActive && Model.AccountIsActive) ? "is-active" : "is-inactive")">@((Model.ProfileIsActive && Model.AccountIsActive) ? "Đang hoạt động" : "Không hoạt động")</span></section><section class="catalog-detail-card"><h2>Thông tin hành chính</h2><dl class="profile-detail-list"><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Số điện thoại</dt><dd>@(Model.PhoneNumber ?? "Chưa cập nhật")</dd></div><div><dt>Ngày sinh</dt><dd>@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd></div><div><dt>Ngày đăng ký</dt><dd>@Model.AccountCreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</dd></div></dl><p class="catalog-note">Không hiển thị mật khẩu, mã xác thực hoặc dữ liệu nhạy cảm của tài khoản.</p></section></div></div>
