@model PatientsIndexViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Quản lý bệnh nhân"; var data = Model.Results; }
<div class="dashboard-page catalog-page profile-management-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Hồ sơ người bệnh</span><h1>Quản lý bệnh nhân</h1><p>Tra cứu và cập nhật thông tin hành chính tối thiểu của bệnh nhân đã đăng ký.</p></div></header>
<section class="catalog-stats"><article><span>Tổng bệnh nhân</span><strong>@data.Summary.Total</strong></article><article class="is-success"><span>Đang hoạt động</span><strong>@data.Summary.Active</strong></article><article class="is-muted"><span>Không hoạt động</span><strong>@data.Summary.Inactive</strong></article></section>
<section class="catalog-panel"><form method="get" class="catalog-filter patient-filter" role="search"><label><span class="visually-hidden">Tìm bệnh nhân</span><input name="search" value="@Model.Query.Search" placeholder="Tìm theo họ tên, email hoặc số điện thoại" /></label><select name="status" aria-label="Lọc trạng thái"><option value="">Mọi trạng thái</option><option value="active" selected="@(Model.Query.Status == "active")">Đang hoạt động</option><option value="inactive" selected="@(Model.Query.Status == "inactive")">Không hoạt động</option></select><select name="sortBy" aria-label="Sắp xếp"><option value="name" selected="@(Model.Query.SortBy == "name")">Theo tên</option><option value="email" selected="@(Model.Query.SortBy == "email")">Theo email</option><option value="createdAt" selected="@(Model.Query.SortBy == "createdAt")">Theo ngày đăng ký</option></select><input type="hidden" name="sortDirection" value="@Model.Query.SortDirection" /><select name="pageSize"><option value="10" selected="@(Model.Query.PageSize == 10)">10 / trang</option><option value="20" selected="@(Model.Query.PageSize == 20)">20 / trang</option><option value="50" selected="@(Model.Query.PageSize == 50)">50 / trang</option></select><button class="btn btn-secondary" type="submit">Áp dụng</button><a class="btn btn-ghost" asp-action="Index">Đặt lại</a></form>
@if(data.Items.Count == 0){<div class="catalog-empty"><span aria-hidden="true">＋</span><h2>Chưa có bệnh nhân phù hợp</h2><p>Hãy điều chỉnh từ khóa hoặc bộ lọc trạng thái.</p></div>}else{<div class="catalog-table-wrap"><table class="catalog-table"><thead><tr><th>Bệnh nhân</th><th>Liên hệ</th><th>Ngày sinh</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var item in data.Items){<tr><td data-label="Bệnh nhân"><strong>@item.FullName</strong><small class="profile-secondary">@item.Email</small></td><td data-label="Liên hệ">@(item.PhoneNumber ?? "Chưa cập nhật")</td><td data-label="Ngày sinh">@(item.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</td><td data-label="Trạng thái"><span class="status-badge @((item.ProfileIsActive && item.AccountIsActive) ? "is-active" : "is-inactive")">@((item.ProfileIsActive && item.AccountIsActive) ? "Đang hoạt động" : "Không hoạt động")</span></td><td class="catalog-actions"><a class="btn btn-ghost btn-sm" asp-action="Details" asp-route-id="@item.Id">Chi tiết</a></td></tr>}</tbody></table></div><nav class="catalog-pagination"><span>Hiển thị @data.Items.Count / @data.TotalCount bệnh nhân</span><div>@if(data.Page>1){<a asp-action="Index" asp-route-search="@Model.Query.Search" asp-route-status="@Model.Query.Status" asp-route-sortBy="@Model.Query.SortBy" asp-route-sortDirection="@Model.Query.SortDirection" asp-route-pageSize="@Model.Query.PageSize" asp-route-page="@(data.Page-1)">Trước</a>}<strong>Trang @data.Page / @Math.Max(data.TotalPages,1)</strong>@if(data.Page<data.TotalPages){<a asp-action="Index" asp-route-search="@Model.Query.Search" asp-route-status="@Model.Query.Status" asp-route-sortBy="@Model.Query.SortBy" asp-route-sortDirection="@Model.Query.SortDirection" asp-route-pageSize="@Model.Query.PageSize" asp-route-page="@(data.Page+1)">Sau</a>}</div></nav>}</section></div>
