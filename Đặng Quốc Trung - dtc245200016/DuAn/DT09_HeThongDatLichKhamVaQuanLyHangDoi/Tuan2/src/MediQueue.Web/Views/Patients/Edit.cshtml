@model EditPatientProfileViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Chỉnh sửa bệnh nhân"; }
<div class="dashboard-page catalog-page catalog-form-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Hồ sơ bệnh nhân</span><h1>Cập nhật thông tin hành chính</h1><p>Chỉ chỉnh sửa họ tên, số điện thoại và ngày sinh; tài khoản đăng nhập được giữ nguyên.</p></div></header><section class="catalog-form-card"><form method="post" data-loading-form>@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-field"><label>Email tài khoản</label><input value="@Model.Email" readonly aria-readonly="true" /></div><div class="form-field"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name"/><span asp-validation-for="FullName"></span></div><div class="form-field"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" autocomplete="tel"/><span asp-validation-for="PhoneNumber"></span></div><div class="form-field"><label asp-for="DateOfBirth"></label><input asp-for="DateOfBirth" type="date"/><span asp-validation-for="DateOfBirth"></span></div><div class="catalog-form-actions"><a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Hủy</a><button class="btn btn-primary" type="submit" data-loading-text="Đang lưu...">Lưu thay đổi</button></div></form></section></div>
