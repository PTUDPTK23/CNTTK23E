@model RoomFormViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Thêm phòng khám"; }
<div class="dashboard-page catalog-page catalog-form-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Phòng khám</span><h1>Thêm phòng khám</h1><p>Khai báo không gian phục vụ mới trong cơ sở y tế.</p></div></header><section class="catalog-form-card"><form method="post" data-loading-form>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-field"><label asp-for="Code"></label><input asp-for="Code" autocomplete="off" placeholder="VD: P101" /><span asp-validation-for="Code"></span></div><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" autocomplete="off" placeholder="VD: Phòng khám 101" /><span asp-validation-for="Name"></span></div><div class="form-field"><label asp-for="Location"></label><input asp-for="Location" autocomplete="off" placeholder="VD: Tầng 1, khu A" /><span asp-validation-for="Location"></span></div><div class="catalog-form-actions"><a class="btn btn-ghost" asp-action="Index">Hủy</a><button class="btn btn-primary" type="submit">Tạo phòng khám</button></div></form></section></div>
