@model RoomDetailsResponse
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Chi tiết phòng khám"; }
<div class="dashboard-page catalog-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Phòng khám · @Model.Code</span><h1>@Model.Name</h1><p>@(Model.Location ?? "Vị trí chưa được cập nhật")</p></div><a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Chỉnh sửa</a></header><div class="catalog-detail-grid"><section class="catalog-identity"><span class="catalog-monogram" aria-hidden="true">@Model.Code[..Math.Min(2, Model.Code.Length)]</span><strong>@Model.Code</strong><h2>@Model.Name</h2><span class="status-badge @(Model.IsActive ? "is-active" : "is-inactive")">@(Model.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")</span></section><section class="catalog-detail-card"><h2>Quan hệ nghiệp vụ</h2><dl><div><dt>Lịch bác sĩ</dt><dd>@Model.ScheduleCount</dd></div><div><dt>Lịch đang hoạt động</dt><dd>@Model.ActiveScheduleCount</dd></div><div><dt>Khung giờ</dt><dd>@Model.TimeSlotCount</dd></div><div><dt>Khung giờ đang hoạt động</dt><dd>@Model.ActiveTimeSlotCount</dd></div></dl><p class="catalog-note">Phòng chỉ có thể ngừng hoạt động khi không còn lịch hoặc khung giờ đang hoạt động.</p></section></div><section class="catalog-danger-zone"><div><h2>Trạng thái sử dụng</h2><p>Dữ liệu được bảo toàn và có thể kích hoạt lại.</p></div>@if(Model.IsActive){<form method="post" asp-action="Deactivate" asp-route-id="@Model.Id" data-confirm-form data-confirm-title="Ngừng hoạt động phòng khám?" data-confirm-message="Phòng sẽ không còn sẵn sàng cho lịch mới.">@Html.AntiForgeryToken()<button class="btn btn-danger-soft" type="submit">Ngừng hoạt động</button></form>}else{<form method="post" asp-action="Activate" asp-route-id="@Model.Id" data-confirm-form data-confirm-title="Kích hoạt lại phòng khám?" data-confirm-message="Phòng sẽ sẵn sàng để sử dụng trở lại.">@Html.AntiForgeryToken()<button class="btn btn-primary" type="submit">Kích hoạt lại</button></form>}</section><partial name="_CatalogConfirmDialog" /></div>
