@model RoomsIndexViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Quản lý phòng khám"; var data = Model.Results; }
<div class="dashboard-page catalog-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Danh mục cơ sở y tế</span><h1>Quản lý phòng khám</h1><p>Theo dõi vị trí, lịch sử dụng và trạng thái từng phòng.</p></div><a class="btn btn-primary" asp-action="Create">Thêm phòng khám</a></header><section class="catalog-stats" aria-label="Thống kê phòng khám"><article><span>Tổng phòng</span><strong>@data.Summary.Total</strong></article><article class="is-success"><span>Đang hoạt động</span><strong>@data.Summary.Active</strong></article><article class="is-muted"><span>Đã vô hiệu hóa</span><strong>@data.Summary.Inactive</strong></article></section><section class="catalog-panel"><form method="get" class="catalog-filter" role="search"><label><span class="visually-hidden">Tìm phòng khám</span><input name="search" value="@Model.Query.Search" placeholder="Tìm theo mã, tên hoặc vị trí" /></label><select name="status" aria-label="Lọc trạng thái"><option value="">Mọi trạng thái</option><option value="active" selected="@(Model.Query.Status == "active")">Đang hoạt động</option><option value="inactive" selected="@(Model.Query.Status == "inactive")">Đã vô hiệu hóa</option></select><select name="sortBy" aria-label="Sắp xếp"><option value="code" selected="@(Model.Query.SortBy == "code")">Theo mã</option><option value="name" selected="@(Model.Query.SortBy == "name")">Theo tên</option><option value="location" selected="@(Model.Query.SortBy == "location")">Theo vị trí</option><option value="status" selected="@(Model.Query.SortBy == "status")">Theo trạng thái</option></select><input type="hidden" name="sortDirection" value="@Model.Query.SortDirection" /><select name="pageSize"><option value="10" selected="@(Model.Query.PageSize == 10)">10 / trang</option><option value="20" selected="@(Model.Query.PageSize == 20)">20 / trang</option><option value="50" selected="@(Model.Query.PageSize == 50)">50 / trang</option></select><button class="btn btn-secondary" type="submit">Áp dụng</button><a class="btn btn-ghost" asp-action="Index">Đặt lại</a></form>@if(data.Items.Count == 0){<div class="catalog-empty"><span aria-hidden="true">＋</span><h2>Chưa có phòng khám phù hợp</h2><p>Điều chỉnh bộ lọc hoặc thêm phòng đầu tiên.</p><a class="btn btn-primary" asp-action="Create">Thêm phòng khám</a></div>}else{<div class="catalog-table-wrap"><table class="catalog-table"><thead><tr><th>Mã</th><th>Phòng khám</th><th>Vị trí</th><th>Lịch / Khung giờ</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var item in data.Items){<tr><td data-label="Mã"><strong class="catalog-code">@item.Code</strong></td><td data-label="Phòng">@item.Name</td><td data-label="Vị trí">@(item.Location ?? "Chưa cập nhật")</td><td data-label="Lịch / Khung giờ">@item.ScheduleCount / @item.TimeSlotCount</td><td data-label="Trạng thái"><span class="status-badge @(item.IsActive ? "is-active" : "is-inactive")">@(item.IsActive ? "Đang hoạt động" : "Đã vô hiệu hóa")</span></td><td class="catalog-actions"><a class="btn btn-ghost btn-sm" asp-action="Details" asp-route-id="@item.Id">Chi tiết</a></td></tr>}</tbody></table></div><nav class="catalog-pagination"><span>Hiển thị @data.Items.Count / @data.TotalCount phòng</span><div>@if(data.Page>1){<a asp-action="Index" asp-route-search="@Model.Query.Search" asp-route-status="@Model.Query.Status" asp-route-sortBy="@Model.Query.SortBy" asp-route-pageSize="@Model.Query.PageSize" asp-route-page="@(data.Page-1)">Trước</a>}<strong>Trang @data.Page / @Math.Max(data.TotalPages,1)</strong>@if(data.Page<data.TotalPages){<a asp-action="Index" asp-route-search="@Model.Query.Search" asp-route-status="@Model.Query.Status" asp-route-sortBy="@Model.Query.SortBy" asp-route-pageSize="@Model.Query.PageSize" asp-route-page="@(data.Page+1)">Sau</a>}</div></nav>}</section></div>
