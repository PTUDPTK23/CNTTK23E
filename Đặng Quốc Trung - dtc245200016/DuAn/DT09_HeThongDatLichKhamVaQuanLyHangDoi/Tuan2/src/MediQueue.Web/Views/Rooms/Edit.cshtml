@model RoomFormViewModel
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Chỉnh sửa phòng khám"; }
<div class="dashboard-page catalog-page catalog-form-page"><header class="dashboard-page-heading"><div><span class="eyebrow">Phòng @Model.Code</span><h1>Chỉnh sửa phòng khám</h1><p>Cập nhật thông tin định danh và vị trí phòng.</p></div></header><section class="catalog-form-card"><form method="post" data-loading-form>@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-field"><label asp-for="Code"></label><input asp-for="Code" /><span asp-validation-for="Code"></span></div><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name"></span></div><div class="form-field"><label asp-for="Location"></label><input asp-for="Location" /><span asp-validation-for="Location"></span></div><div class="catalog-form-actions"><a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Hủy</a><button class="btn btn-primary" type="submit">Lưu thay đổi</button></div></form></section></div>
