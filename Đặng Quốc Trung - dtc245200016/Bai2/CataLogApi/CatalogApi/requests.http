@api = http://localhost:5100

### 1. Danh sach san pham - 200 OK
GET {{api}}/api/products

### 2. Chi tiet san pham - 200 OK
GET {{api}}/api/products/1

### 3. San pham khong ton tai - 404
GET {{api}}/api/products/999

### 4. ID khong hop le - 404
GET {{api}}/api/products/abc

### 5. Sai phuong thuc HTTP - 405
PUT {{api}}/api/products

### 6. Tao san pham hop le - 201 Created
POST {{api}}/api/products
Content-Type: application/json

{
  "name": "Lap trinh gRPC",
  "description": "Tai lieu bai 5",
  "price": 80000
}

### 7. Tao san pham sai gia - 400 Bad Request
POST {{api}}/api/products
Content-Type: application/json

{
  "name": "San pham loi",
  "description": "",
  "price": -1
}

### 8. Thieu Content-Type - 415
POST {{api}}/api/products

{
  "name": "Lap trinh gRPC",
  "description": "Tai lieu bai 5",
  "price": 80000
}