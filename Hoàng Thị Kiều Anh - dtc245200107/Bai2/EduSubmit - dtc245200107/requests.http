### 13. Rut bai nop - 204
# Thay bang ID nhan duoc tu POST o muc 11
DELETE {{baseUrl}}/api/submissions/908de73f-6b06-4017-ae87-a0710fd71c92

### 14. GET bai nop sau khi xoa - 404
# Su dung cung ID da DELETE o muc 13
GET {{baseUrl}}/api/submissions/908de73f-6b06-4017-ae87-a0710fd71c92
