@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject AdminSessionState AdminSession
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Đăng nhập | Hệ thống chat hỗ trợ trực tuyến</PageTitle>

<main class="page">
    <section class="intro" aria-label="Giới thiệu hệ thống">
        <div class="brand">
            <div class="brand-mark" aria-hidden="true">C</div>
            <div><div class="brand-name">Chat hỗ trợ</div><div class="brand-caption">HỖ TRỢ KHÁCH HÀNG TRỰC TUYẾN</div></div>
        </div>
        <div class="hero">
            <div class="eyebrow">KẾT NỐI KHÁCH HÀNG · HỖ TRỢ KỊP THỜI</div>
            <h1>Hỗ trợ nhanh chóng,<br />kết nối dễ dàng.</h1>
            <div class="hero-copy">Tiếp nhận và phản hồi yêu cầu của khách hàng<br />trong một không gian trò chuyện tập trung.</div>
        </div>
        <div class="copyright">© 2026 Hệ thống chat hỗ trợ trực tuyến</div>
    </section>
    <section class="form-side" aria-label="Đăng nhập">
        <EditForm Model="form" OnValidSubmit="SubmitLogin" class="login">
            <DataAnnotationsValidator />
            <h2>Chào mừng trở lại</h2>
            <p class="subtitle">Đăng nhập để tiếp nhận hoặc theo dõi hội thoại hỗ trợ</p>
            <div class="field">
                <label for="username">Tên đăng nhập</label>
                <div class="input-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
                    <InputText id="username" @bind-Value="form.Username" autocomplete="username" placeholder="Nhập tên đăng nhập" />
                </div>
                <ValidationMessage For="@(() => form.Username)" />
            </div>
            <div class="field">
                <label for="password">Mật khẩu</label>
                <div class="input-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v2"/></svg>
                    <InputText id="password" @bind-Value="form.Password" type="@(showPassword ? "text" : "password")" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                    <button class="toggle" type="button" @onclick="TogglePassword">@(showPassword ? "Ẩn" : "Hiện")</button>
                </div>
                <ValidationMessage For="@(() => form.Password)" />
            </div>
            <div class="options">
                <label class="remember"><InputCheckbox @bind-Value="form.RememberMe" /> Ghi nhớ đăng nhập</label>
                <a href="mailto:hotro@congty.vn?subject=Kh%C3%B4i%20ph%E1%BB%A5c%20m%E1%BA%ADt%20kh%E1%BA%A9u">Quên mật khẩu?</a>
            </div>
            <button class="submit" type="submit">Đăng nhập</button>
            <div class="notice">
                <div class="notice-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 5.5h16v11H9l-5 3v-14Z"/><path d="M8 10h8m-8 3h5"/></svg></div>
                <div><strong>Tài khoản quản trị viên</strong><span>Dùng tài khoản Admin để quản lý hệ thống chat hỗ trợ trực tuyến.</span></div>
            </div>
            <p class="help">Chưa có tài khoản? <a href="/dang-ky">Đăng ký ngay</a></p>
            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <p class="status" role="status">@statusMessage</p>
            }
        </EditForm>
    </section>
</main>

@code {
    private readonly LoginForm form = new();
    private bool showPassword;
    private string? statusMessage;

    private void TogglePassword() => showPassword = !showPassword;

    private async Task SubmitLogin()
    {
        statusMessage = null;
        try
        {
            var client = HttpClientFactory.CreateClient("ChatSupportBackend");
            using var response = await client.PostAsJsonAsync("api/auth/login", new
            {
                username = form.Username,
                password = form.Password,
                rememberMe = form.RememberMe
            });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (result is not null && result.Role == "Admin" && !string.IsNullOrWhiteSpace(result.AccessToken))
                {
                    AdminSession.SignIn(result.AccessToken, result.DisplayName, result.Role);
                    await JS.InvokeVoidAsync("sessionStorage.setItem", "chat-admin-token", result.AccessToken);
                    await JS.InvokeVoidAsync("sessionStorage.setItem", "chat-admin-name", result.DisplayName);
                    await JS.InvokeVoidAsync("sessionStorage.setItem", "chat-admin-role", result.Role);
                    Navigation.NavigateTo("/admin");
                }
                else
                {
                    statusMessage = "Tài khoản này không có quyền quản trị.";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                statusMessage = "Tên đăng nhập hoặc mật khẩu không chính xác.";
            }
            else
            {
                statusMessage = "Không thể đăng nhập lúc này. Vui lòng thử lại.";
            }
        }
        catch (HttpRequestException)
        {
            statusMessage = "Chưa kết nối được backend. Hãy chạy dự án backend tại cổng 5131.";
        }
    }

    private sealed record LoginResponse(string Message, string DisplayName, string Username, string Role, string AccessToken);

    private sealed class LoginForm
    {
        [Required(ErrorMessage = "Vui lòng nhập tên đăng nhập.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
