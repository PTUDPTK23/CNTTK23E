# Chỉ dùng mật khẩu mẫu cho demo cục bộ. .env thật không được commit.
POSTGRES_PASSWORD=notifylab_local_demo
RABBITMQ_PASSWORD=notifylab_local_demo
ENABLE_DEMO_FAILURES=true
API_PORT=5080
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
